⟁Pop⟁ llama_attention_manifest {
  "name": "llama_attention",
  "version": "1.0.0",
  "description": "Llama Multi-Head Attention mechanism in K'UHUL",
  "author": "K'UHUL Contributors",
  "license": "MIT"
}

⟁Xul⟁ llama_attention
  ⟁Pop⟁ attention_config {
    "num_heads": 32,
    "head_dim": 128,
    "hidden_size": 4096,
    "dropout": 0.0
  }

  ⟁Pop⟁ forward(x, mask) ⟁Xul⟁
    ⟁Wo⟁ seq_len = @shape(x)[0]
    ⟁Wo⟁ hidden_size = @shape(x)[1]

    ⟁Sek⟁ seq_len == 0
      ⟁Ch'en⟁ x
    ⟁Xul⟁

    ⟁Wo⟁ config = attention_config

    ⟁Wo⟁ Q = @matmul(x, @get_weight("wq"))
    ⟁Wo⟁ K = @matmul(x, @get_weight("wk"))
    ⟁Wo⟁ V = @matmul(x, @get_weight("wv"))

    ⟁Wo⟁ scale = 1.0 / @sqrt(@float(config["head_dim"]))

    ⟁Wo⟁ scores = @matmul(Q, @transpose(K))
    ⟁Wo⟁ scores = @multiply(scores, scale)

    ⟁Sek⟁ mask != null
      ⟁Wo⟁ scores = @apply_mask(scores, mask)
    ⟁Xul⟁

    ⟁Wo⟁ scores = @softmax(scores)

    ⟁Wo⟁ output = @matmul(scores, V)

    ⟁Wo⟁ output = @matmul(output, @get_weight("wo"))

    ⟁Ch'en⟁ output
  ⟁Xul⟁

  ⟁Pop⟁ scaled_dot_product_attention(Q, K, V, mask) ⟁Xul⟁
    ⟁Wo⟁ head_dim = @shape(Q)[@last()]
    ⟁Wo⟁ scale = 1.0 / @sqrt(@float(head_dim))

    ⟁Wo⟁ scores = @matmul(Q, @transpose(K, [-2, -1]))
    ⟁Wo⟁ scores = @multiply(scores, scale)

    ⟁Sek⟁ mask != null
      ⟁Wo⟁ scores = @add(scores, @multiply(mask, -10000.0))
    ⟁Xul⟁

    ⟁Wo⟁ attn_weights = @softmax(scores, @last_axis())

    ⟁Wo⟁ output = @matmul(attn_weights, V)

    ⟁Ch'en⟁ output
  ⟁Xul⟁

  ⟁Pop⟁ split_heads(x, num_heads) ⟁Xul⟁
    ⟁Wo⟁ batch_size = @shape(x)[0]
    ⟁Wo⟁ seq_len = @shape(x)[1]
    ⟁Wo⟁ head_dim = @shape(x)[2] / num_heads

    ⟁Wo⟁ x = @reshape(x, [batch_size, seq_len, num_heads, head_dim])
    ⟁Wo⟁ x = @transpose(x, [0, 2, 1, 3])

    ⟁Ch'en⟁ x
  ⟁Xul⟁

  ⟁Pop⟁ combine_heads(x, num_heads) ⟁Xul⟁
    ⟁Wo⟁ x = @transpose(x, [0, 2, 1, 3])

    ⟁Wo⟁ batch_size = @shape(x)[0]
    ⟁Wo⟁ seq_len = @shape(x)[1]
    ⟁Wo⟁ head_dim = @shape(x)[3]

    ⟁Wo⟁ x = @reshape(x, [batch_size, seq_len, num_heads * head_dim])

    ⟁Ch'en⟁ x
  ⟁Xul⟁

  ⟁Pop⟁ apply_rotary_embeddings(x, freqs) ⟁Xul⟁
    ⟁Wo⟁ x_real = x[0]
    ⟁Wo⟁ x_imag = x[1]

    ⟁Wo⟁ cos_f = @cos(freqs)
    ⟁Wo⟁ sin_f = @sin(freqs)

    ⟁Wo⟁ x_new_real = @multiply(x_real, cos_f) - @multiply(x_imag, sin_f)
    ⟁Wo⟁ x_new_imag = @multiply(x_real, sin_f) + @multiply(x_imag, cos_f)

    ⟁Ch'en⟁ [x_new_real, x_new_imag]
  ⟁Xul⟁
⟁Xul⟁

C@@L HANDLER llama.attention
  ⟁Pop⟁ attention_handler {
    "params": {
      "query": "tensor",
      "key": "tensor",
      "value": "tensor",
      "mask": "tensor"
    },
    "returns": {
      "output": "tensor"
    }
  }

  ⟁Wo⟁ query = @get_param("query")
  ⟁Wo⟁ key = @get_param("key")
  ⟁Wo⟁ value = @get_param("value")
  ⟁Wo⟁ mask = @get_param("mask")

  ⟁Wo⟁ output = llama_attention.forward([query, key, value, mask])

  ⟁Ch'en⟁ {
    "output": output
  }
C@@L END
